<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Deterministic, authoritative Sandtable simulation domain.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- CNA001/CNA002: see docs/work/plans/2026-11-23-codebase-overhaul-direction.md,
         Section 2 and Section 5. Scoped to Cna.Core (and Cna.Core.Tests) for now rather
         than wired repo-wide via Directory.Build.props as that doc describes: this
         keeps the blast radius of a brand-new analyzer limited to the one project where
         the dangerous patterns actually live, while every other project here already
         has TreatWarningsAsErrors=true. Widening to Directory.Build.props is a one-line
         follow-up once this has run clean in CI for a while. -->
    <ProjectReference Include="../Cna.Analyzers/Cna.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <InternalsVisibleTo Include="Cna.Core.Tests" />

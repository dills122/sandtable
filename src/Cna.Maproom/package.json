{
  "name": "@sandtable/maproom-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve maproom-alpha --host 127.0.0.1 --port 4200",
    "start:connected": "ng serve maproom-alpha --host 127.0.0.1 --port 4300 --proxy-config proxy.connected.json",
    "build": "npm run build:lib && ng build maproom-alpha",
    "build:lib": "ng build field-atlas",
    "test": "ng test maproom-alpha --watch=false && ng test field-atlas --watch=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p .storybook/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "storybook": "ng run field-atlas:storybook",
    "build-storybook": "ng run field-atlas:build-storybook",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run build-storybook"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@lucide/angular": "1.58.0",
    "@ngrx/signals": "22.0.1",
    "@ngx-formly/core": "10.0.1",
    "@ngx-formly/material": "10.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.1",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/angular-vite": "10.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "ng-packagr": "22.2.4",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "sass": "1.105.2",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "@angular/animations": "22.2.3"
  },
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=10 <11"
  }
}

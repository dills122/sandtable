<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Description>
      Dev-only tool: boots one real campaign (real journal, real Orleans silo, real outward
      HTTP API) and keeps it listening, so a real out-of-process client -- the
      Cna.RecommendationConnector service, a curl session, a human -- can drive a genuinely
      live local session against it. Not a production host: uses the file-backed journal
      (CampaignDurableAuthorityJournal) and in-memory localhost clustering instead of the
      Postgres/Marten stack Cna.OrleansHost requires outside tests, same scope tradeoff the
      test suite's own manual-verification harness already makes.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cna.Core/Cna.Core.csproj" />
    <ProjectReference Include="../Cna.OrleansHost/Cna.OrleansHost.csproj" />
  </ItemGroup>
</Project>

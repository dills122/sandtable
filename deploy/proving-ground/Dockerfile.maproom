FROM node:22.23.3-bookworm@sha256:0e5f906573693feaa1e21057ebdcfdb5bd5021f050b2dc7c9deceb629c7da2a8 AS build
WORKDIR /workspace
COPY src/Cna.Maproom/package.json src/Cna.Maproom/package-lock.json ./
RUN npm ci
COPY src/Cna.Maproom/ ./
RUN npm run build

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
COPY --from=build /workspace/dist/maproom-alpha/browser /usr/share/nginx/html
COPY deploy/proving-ground/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

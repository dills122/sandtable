      "required": ["contractVersion", "campaignId", "side", "seatAuthorityId", "grantGeneration", "seatEpoch", "storeRevocationEpoch", "sessionGeneration", "clockAtUtc", "clockAvailable", "grantIssuedAtUtc", "grantExpiresAtUtc", "authenticated"],
      "properties": {
        "contractVersion": { "const": 1 }, "campaignId": { "$ref": "#/$defs/campaignId" },
        "side": { "$ref": "#/$defs/side" }, "seatAuthorityId": { "$ref": "#/$defs/seatAuthorityId" },
        "grantGeneration": { "$ref": "#/$defs/counter" }, "seatEpoch": { "$ref": "#/$defs/counter" },
        "storeRevocationEpoch": { "$ref": "#/$defs/counter" },

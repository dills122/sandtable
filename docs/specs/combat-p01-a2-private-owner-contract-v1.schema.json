        "operationStage": { "type": "integer", "minimum": 1, "maximum": 3 },
        "playerPhaseSlot": { "enum": ["first-acting-side", "second-acting-side"] },
        "phasingSide": { "$ref": "#/$defs/side" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 2147483647 }

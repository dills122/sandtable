      "required": ["contractVersion", "campaignId", "creationRequestHash", "elevenLedgerRootHash", "dependencyManifestHash", "checkpointHash", "journalKey"],
      "properties": {
        "contractVersion": { "const": 1 }, "campaignId": { "$ref": "#/$defs/campaignId" },
        "creationRequestHash": { "$ref": "#/$defs/hash" }, "elevenLedgerRootHash": { "$ref": "#/$defs/hash" },

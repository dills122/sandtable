      "properties": {
        "contractVersion": { "const": 1 }, "campaignId": { "$ref": "#/$defs/campaignId" }, "side": { "$ref": "#/$defs/side" },
        "seatAuthorityId": { "$ref": "#/$defs/seatAuthorityId" }, "grantGeneration": { "$ref": "#/$defs/counter" },
        "sessionGeneration": { "$ref": "#/$defs/counter" }, "seatEpoch": { "$ref": "#/$defs/counter" },
        "clockAtUtc": { "$ref": "#/$defs/utc" }, "clockAvailable": { "type": "boolean" },
        "journalKey": { "$ref": "#/$defs/journalKey" }, "expectedSequence": { "$ref": "#/$defs/counter" },
        "expectedRecordHash": { "$ref": "#/$defs/hash" }, "expectedStateVersion": { "$ref": "#/$defs/counter" },
        "expectedPrefix": { "$ref": "#/$defs/hash" }, "fence": { "$ref": "#/$defs/counter" }

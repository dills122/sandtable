        "contractVersion": { "const": 1 }, "campaignId": { "$ref": "#/$defs/campaignId" },
        "side": { "$ref": "#/$defs/side" }, "seatAuthorityId": { "$ref": "#/$defs/seatAuthorityId" },
        "grantGeneration": { "$ref": "#/$defs/counter" }, "issuerRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "maxLength": 64 },

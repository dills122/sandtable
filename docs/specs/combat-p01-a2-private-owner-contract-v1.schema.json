        "acceptedAtUnixMilliseconds": { "$ref": "#/$defs/counter" },
        "controlHash": { "$ref": "#/$defs/hash" }, "worldHash": { "$ref": "#/$defs/hash" },
        "randomHash": { "$ref": "#/$defs/hash" }

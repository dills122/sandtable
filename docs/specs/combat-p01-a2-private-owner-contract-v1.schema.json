{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sandtable.combat.p01.a2-private-owner-contract.v1",
  "title": "Proposed private P01 A2 owner proof contract v1",
  "description": "Unapproved, disabled-by-default contract proposal. No public or native issue.",
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 },
    "publicRef": { "type": "string", "pattern": "^pub\\.[0-9a-f]{64}$", "maxLength": 68 },
